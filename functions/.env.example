# Copy to functions/.env (gitignored). The emulator loads it automatically.
# Without credentials the functions fall back to MockStore, which is fine for UI work --
# including the whole cart-link flow, which mock mode short-circuits end to end.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional: kroger | mock. Forces an adapter regardless of credentials.
STORE_ADAPTER=
# Optional: point at Kroger's certification env instead of production.
# KROGER_BASE_URL=https://api-ce.kroger.com

# --- Cart push (user OAuth) ------------------------------------------------------------
# Where Kroger sends the browser back after the consent screen. Must match the redirect
# URI registered in the Kroger dev portal EXACTLY, or authorize fails with an opaque error.
#   local:  http://127.0.0.1:5001/<project-id>/us-central1/krogerCallback
#   prod:   https://us-central1-<project-id>.cloudfunctions.net/krogerCallback
# Unset in mock mode, where the callback URL is derived from the request instead.
KROGER_REDIRECT_URI=

# Comma-separated origins we are willing to redirect the browser back to after linking.
# This is an open-redirect guard, so keep it to origins we actually own.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
APP_ALLOWED_ORIGINS=
