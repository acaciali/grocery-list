{
  "name": "@grocery/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill": "esbuild src/scripts/backfill-keys.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/backfill-keys.cjs --external:firebase-admin && node lib/backfill-keys.cjs"
  },
  "dependencies": {
    "@grocery/shared": "*",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
