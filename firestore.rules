rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared family list -- deliberately open for the hackathon (no per-user lists yet).
    // Field shape is enforced loosely on write so a buggy client can't scribble
    // arbitrary keys, while every legacy doc and optional field stays valid.
    match /groceries/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly([
        'name', 'checked', 'createdAt',
        'key', 'quantity', 'unit', 'category', 'source', 'sourceId',
        'storeProductId', 'match'
      ]);
    }

    // Shared product-search cache, written by Cloud Functions (Admin SDK bypasses rules)
    // and read by everyone. Clients never write it.
    match /storeProducts/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // "Which product did I pick for this search last time" -- per-user memory.
      match /productPrefs/{key} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Kroger OAuth tokens. Admin SDK only -- a refresh token readable from the
      // browser is an account compromise, not a demo bug. No client access, ever.
      match /private/{doc=**} {
        allow read, write: if false;
      }
    }

    // Audit mirror of what we sent to the store cart. The Public API is write-only,
    // so this is the only cart state we have. Functions write it; clients read it.
    match /cartBatches/{id} {
      allow read: if true;
      allow write: if false;
    }

    // POC: single-user app, open like groceries. Doc IDs are the normalized item key
    // by convention (the data layer writes them that way -- it is what makes
    // upsert-by-key idempotent). Tighten before anything goes public.
    match /inventory/{id} {
      allow read, create, update, delete: if true;
    }

    // One shared cookbook, like groceries and the pantry. Deliberately plain CRUD --
    // no field validation here, the Recipe shape is enforced by TypeScript
    // (packages/shared/src/types.ts).
    //
    // ⚠️ main had this as `if request.auth != null`, from when the app still had
    // anonymous auth, AND a second permissive block for the same path alongside it.
    // Auth is gone now (single-user POC), so the auth-gated block can never pass --
    // recipes kept working only because Firestore ORs matching blocks and the second
    // one allowed everything. Collapsed to the one block that describes what is
    // actually enforced, so nobody later deletes the permissive half believing the
    // auth half still covers it. Tighten all three collections together when auth
    // comes back.
    match /recipes/{id} {
      allow read, create, update, delete: if true;
    }
  }
}
