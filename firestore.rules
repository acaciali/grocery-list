rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /groceries/{id} {
      allow read, create, update, delete: if true;
    }

    // POC: single-user app, open like groceries. Doc IDs are the normalized item key
    // by convention (the data layer writes them that way -- it is what makes
    // upsert-by-key idempotent). Tighten before anything goes public.
    match /inventory/{id} {
      allow read, create, update, delete: if true;
    }
  }
}
